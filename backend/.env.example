# Copiá este archivo a ".env" y completá los valores.
# El archivo .env NO se sube a git (está en .gitignore).

# Base de datos (SQLite por defecto; más adelante se cambia a Postgres).
DATABASE_URL=sqlite:///./portfolioquant.db

# Poné true para ver el SQL en consola (debug).
DB_ECHO=false

# API key gratuita de FRED (datos macro: tasas, inflación).
# Se obtiene gratis en: https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=
